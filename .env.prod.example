# Copy to .env.prod and fill in. Used by docker-compose.prod.yml.
POSTGRES_PASSWORD=change-me
# 32+ random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
# Public URL users open (used for CORS and invitation links).
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
# Optional: deliver invitation emails, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Collab <no-reply@example.com>
