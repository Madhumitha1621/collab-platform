{
  "name": "collab-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "redis:up": "docker compose up -d redis",
    "dev:server": "npm run start:dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/server && npm run build -w apps/web",
    "test": "npm test -w apps/server",
    "test:e2e": "playwright test",
    "load-test": "npm run load-test -w apps/server",
    "seed:demo": "npm run seed:demo -w apps/server",
    "prod:up": "docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build",
    "prod:down": "docker compose -f docker-compose.prod.yml --env-file .env.prod down"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
