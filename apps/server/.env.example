# HTTP / GraphQL API
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Yjs collaboration WebSocket (Hocuspocus)
COLLAB_PORT=1234
COLLAB_MAX_MESSAGE_BYTES=1048576
COLLAB_MAX_MESSAGES_PER_SECOND=200

# PostgreSQL (docker compose maps it to 5433)
DATABASE_URL=postgres://collab:collab@localhost:5433/collab

# Redis (optional). Set it to run several instances behind a load balancer: Yjs updates,
# awareness, GraphQL subscriptions and session revocations then reach every instance.
# Leave it empty for a single instance. `docker compose up -d redis` serves localhost:6379.
REDIS_URL=
# Prefix for Redis channels and keys, so environments can share one Redis.
REDIS_PREFIX=collab

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_SECONDS=86400

# Persistence tuning
PERSIST_FLUSH_MS=500
PERSIST_MAX_RETRIES=5
SNAPSHOT_UPDATE_THRESHOLD=200

# Email invitations and notifications
# Public URL of the web app, used in emailed links.
WEB_URL=http://localhost:5173
# e.g. smtps://user:pass@smtp.example.com:465. Empty: emails are written to the log (development).
SMTP_URL=
MAIL_FROM=Collab <no-reply@collab.local>
INVITATION_TTL_HOURS=168
