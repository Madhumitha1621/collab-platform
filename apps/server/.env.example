# HTTP / GraphQL API
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Yjs collaboration WebSocket (Hocuspocus)
COLLAB_PORT=1234
COLLAB_MAX_MESSAGE_BYTES=1048576
COLLAB_MAX_MESSAGES_PER_SECOND=200

# PostgreSQL (docker compose maps it to 5433)
DATABASE_URL=postgres://collab:collab@localhost:5433/collab

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_SECONDS=86400

# Persistence tuning
PERSIST_FLUSH_MS=500
PERSIST_MAX_RETRIES=5
SNAPSHOT_UPDATE_THRESHOLD=200
